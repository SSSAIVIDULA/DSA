REMOVE OUTER PARENTHESES
class Solution {
    public String removeOuterParentheses(String s) {
        String str="";
        int count=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='('){
                count++;
              if(count>1 ){
                str+=s.charAt(i);
              }
            }
              
            
            
            if(s.charAt(i)==')'){
                count--;
              if(count>=1 ){
                str+=s.charAt(i);
            }
            }
             
            
        }
        return str;
    }
}
