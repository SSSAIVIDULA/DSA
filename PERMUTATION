ARRAY
import java.util.*;
public class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int[] arr=new int[n];
    for(int i=0;i<n;i++){
      arr[i]=sc.nextInt();
    }
    permutate(arr,0);
  }
  static void permutate(int[] arr,int index){
    if(index==arr.length){
      for(int i=0;i<arr.length;i++){
        System.out.print(arr[i]);
      }
      System.out.println();
      return;
    }
    for(int i=index;i<arr.length;i++){
      swap(arr,index,i);
      permutate(arr,index+1);
      swap(arr,index,i);
    }
  }
  static void swap(int[] arr,int i,int k){
    int temp=arr[i];
    arr[i]=arr[k];
    arr[k]=temp;
  }
}
