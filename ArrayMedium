    int neg=1;
    for(int i=0;i<n;i++){
      if(arr[i]>0){
        res[pos]=arr[i];
        pos=pos+2;
      }
      else{
        res[neg]=arr[i];
        neg=neg+2;
      }
    }
    for(int i=0;i<n;i++){
      System.out.print(res[i]+" ");
    }
  }
}
